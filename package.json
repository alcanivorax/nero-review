{
  "name": "nero-review",
  "version": "0.1.3",
  "description": "Review code directly from your terminal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "nero-review": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nero",
    "nero-review",
    "code-review",
    "code-analysis",
    "static-analysis",
    "cli",
    "terminal",
    "developer-tools",
    "devtools",
    "productivity",
    "ai",
    "ai-code-review",
    "review-tool",
    "source-code",
    "code-quality",
    "linting",
    "automation"
  ],
  "author": "alcanivorax",
  "license": "MIT",
  "dependencies": {
    "@openrouter/sdk": "^0.3.11",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "ora": "^9.0.0",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/semver": "^7.7.1",
    "@types/update-notifier": "^6.0.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
