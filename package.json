{
  "name": "nero-review",
  "version": "0.1.0",
  "description": "Review code directly from your terminal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "nero-review": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc"
  },
  "files": [
    "dist",
    "README.npm.md"
  ],
  "readme": "README.npm.md",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nero",
    "code-review",
    "terminal"
  ],
  "author": "alcanivorax",
  "license": "MIT",
  "dependencies": {
    "@openrouter/sdk": "^0.3.11",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
